#        --part 2 two sources --

theta0 = np.deg2rad([0,15])

def give_Rx(SNR, theta0, M, d, v, F):
    
    sigma_n = 10**(-SNR/20)
    
    A = a_lin(theta0, M, d, v, F)
    A_H = A.conj().T
    R = A @ A_H                            
    Rn = np.eye(M,M)*sigma_n**2 
    Rx = R + Rn  

    return Rx
    
Pmbf = np.zeros(len(theta))

def matchedbeamformer(Rx,theta, M, d, v, F0):

    for i, angle in enumerate(theta):
        a = a_lin(angle, M, d, v, F)
        Pmbf[i] = (a.conj().T @ A0 * Rx)

    return Pmbf

    
Rxx = give_Rx(theta, M, d, v, F)
P_mbf  = matchedbeamformer(Rxx,theta, M, d, v, F)

plt.figure(figsize=(11, 4))
plt.subplot(1, 2, 1)
plt.plot(np.rad2deg(theta), P_mbf)
plt.title("(a) matched beamformer")
plt.xlabel("angle [deg]")
plt.ylabel("spatial spectrum")
plt.grid()



