v = 343; # m/s
F = 500 # Hz
M = 7
SNR = 10

lam = v/F
delta = 0.5; 
d = lam * delta; # m

theta = np.deg2rad(np.linspace(-90, 90, 721))

def a_lin(theta, M, d, v, F0):

    th = np.array(theta)
    tau = (d / v) * np.sin(th) 
    m = np.arange(M)

    Am =  np.exp(-1j*2 *np.pi *F * m * tau)
    return Am


A0 = a_lin(0, M, d, v, F)
P = np.zeros(len(theta))


def spatial_spectrum(P,A0,theta, M, d, v, F0):
    for i, angle in enumerate(theta):
        A = a_lin(angle,M, d, v, F)
        P[i] = np.abs(A.conj().T @ A0).item() ** 2

    return P


plt.plot(theta, P)
